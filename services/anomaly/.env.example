# Porta do microserviço de anomalia (o serviço OCR usa 8000)
ANOMALY_PORT=8001

# Diretório onde os baselines treinados são persistidos (um .joblib por TAG)
ANOMALY_MODELS_DIR=./models

# Origens liberadas no CORS (frontend Vite do Forzy)
ANOMALY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limiares (opcionais; padrões vêm do notebook de validação) ---
# ANOMALY_WARN_LEVEL=65
# ANOMALY_CRIT_LEVEL=45
# ANOMALY_HEALTH_OK=85

# Janela e persistência do cálculo
ANOMALY_RESAMPLE_RULE=10s
ANOMALY_FEATURE_WIN=12
ANOMALY_DUTY_THRESHOLD=1.0
ANOMALY_PERSIST_SAMPLES=18
ANOMALY_HEALTH_EWM_ALPHA=0.03
