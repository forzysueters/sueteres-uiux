# Forzy — Gêmeo Digital Industrial · Modelo de configuração
# Copie para .env e preencha com os valores do seu projeto Supabase.

# ─── Supabase — banco, autenticação e storage ────────────────────────────────
# Somente variáveis VITE_* são expostas ao browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Usadas apenas pelos scripts locais (npm run db:*). Nunca chegam ao browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Modelo de OCR (FastAPI — pasta ocr/) ────────────────────────────────────
# Inicie com: uvicorn src.api.main:app
VITE_OCR_API_URL=http://localhost:8000
# Defina como "true" para forçar dados simulados de OCR (demo offline)
VITE_OCR_USE_MOCK=false

# ─── Modelo de anomalia (FastAPI — pasta anomaly/) ───────────────────────────
# Inicie com: uvicorn src.api.main:app --port 8001
VITE_ANOMALY_API_URL=http://localhost:8001
# Defina como "true" para forçar dados simulados de anomalia (demo offline)
VITE_ANOMALY_USE_MOCK=false

# ─── Feature flags ───────────────────────────────────────────────────────────
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_EQUIPMENT_REGISTRATION=true
VITE_ENABLE_PREDICTIVE_MAINTENANCE=true

# ─── Intervalos de atualização (ms) ──────────────────────────────────────────
VITE_DASHBOARD_REFRESH_INTERVAL=15000
VITE_ALERTS_REFRESH_INTERVAL=15000

# ─── UI ──────────────────────────────────────────────────────────────────────
VITE_THEME=dark
VITE_SIDEBAR_OPEN_BY_DEFAULT=true
VITE_MAX_ALERTS_DISPLAY=10

# ─── Ambiente ────────────────────────────────────────────────────────────────
VITE_ENV=development
