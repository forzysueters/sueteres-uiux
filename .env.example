# Industrial Digital Twin - Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:3000

# OCR Model (FastAPI — pasta ocr/). Inicie com: uvicorn src.api.main:app
VITE_OCR_API_URL=http://localhost:8000
# Defina como "true" para forçar dados simulados de OCR (demo offline)
VITE_OCR_USE_MOCK=false

# Feature Flags
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_EQUIPMENT_REGISTRATION=true
VITE_ENABLE_PREDICTIVE_MAINTENANCE=true

# Data Settings
VITE_SENSOR_UPDATE_INTERVAL=2000
VITE_DASHBOARD_REFRESH_INTERVAL=5000
VITE_ALERTS_REFRESH_INTERVAL=3000

# UI Settings
VITE_THEME=dark
VITE_SIDEBAR_OPEN_BY_DEFAULT=true
VITE_MAX_ALERTS_DISPLAY=10

# Analytics (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_KEY=

# Sentry (optional error tracking)
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=

# Environment
VITE_ENV=development
