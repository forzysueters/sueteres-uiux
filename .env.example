# Modelo de .env.local — segredos que o git NÃO versiona.
#
# O .env do repositório já traz os valores públicos (URL e chave publishable do
# Supabase, portas dos modelos), então `npm run dev` funciona sem configurar
# nada. Este arquivo só é necessário para quem vai MEXER NO BANCO.
#
#   cp .env.example .env.local
#
# Depois preencha com os valores do painel do Supabase e rode `npm run db:setup`.

# Project Settings → API keys → secret. Ignora a RLS por completo.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Project Settings → Database → Connection string (senha do Postgres).
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Opcional: aponta os scripts para outro projeto (ex.: um banco de testes).
# SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
