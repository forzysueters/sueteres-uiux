DEFAULT_MODEL=easyocr

# Modelo de visão (OpenAI) — usado no mode=gpt e como fallback do EasyOCR
# quando faltam campos críticos. Chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcional — troca o modelo sem mexer no código (padrão: gpt-5.4-mini)
# OPENAI_VISION_MODEL=gpt-5.4-mini

'http://127.0.0.1:8000/docs' # URL para acessar a documentação da API localmente
