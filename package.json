{
  "name": "forzy-digital-twin",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "bootstrap": "npm install && npm run python:setup",
    "dev": "npm run env:check && npm run dev --workspace @forzy/web",
    "build": "npm run build --workspace @forzy/web",
    "lint": "npm run lint --workspace @forzy/web && npm run python:lint",
    "test": "npm run test:run --workspace @forzy/web && npm run python:test",
    "check": "npm run env:check && npm run lint && npm run test && npm run build",
    "format": "npm run format --workspace @forzy/web",
    "env:check": "node tools/check-env.mjs",
    "python:setup": "node tools/python-tasks.mjs setup",
    "python:test": "node tools/python-tasks.mjs test",
    "python:lint": "node tools/python-tasks.mjs lint",
    "services:start": "docker compose up --build",
    "services:stop": "docker compose down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:users": "node scripts/create-demo-users.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "db:setup": "npm run db:migrate && npm run db:users && npm run db:seed && npm run db:types",
    "db:verify": "node scripts/verify-access.mjs",
    "collector": "node scripts/collector.mjs",
    "collector:status": "node scripts/collector.mjs status",
    "collector:test": "node scripts/collector.mjs test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "pg": "^8.23.0"
  },
  "engines": { "node": ">=22" }
}
