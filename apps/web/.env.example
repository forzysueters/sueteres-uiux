# Forzy — Gêmeo Digital Industrial
#
# Este arquivo é VERSIONADO de propósito: contém apenas valores públicos, os
# mesmos que qualquer pessoa lê no bundle JavaScript da aplicação. Quem protege
# os dados é a Row Level Security do Postgres, não o sigilo destas chaves.
#
# ⚠️  NUNCA coloque segredo neste diretório. SUPABASE_SECRET_KEY e
#     SUPABASE_DB_URL pertencem ao `.env.local` da raiz, usado apenas pelos
#     scripts administrativos e ignorado pelo Git.

# ─── Supabase — banco, autenticação e storage ────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── Modelo de OCR (FastAPI — services/ocr, porta 8000) ─────────────────────
VITE_OCR_API_URL=http://localhost:8000
# "true" força dados simulados de OCR (demo offline)
VITE_OCR_USE_MOCK=false

# ─── Modelo de anomalia (FastAPI — services/anomaly, porta 8001) ────────────
VITE_ANOMALY_API_URL=http://localhost:8001
# "true" força dados simulados de anomalia (demo offline)
VITE_ANOMALY_USE_MOCK=false

# ─── Voz do assistente (Órion) ───────────────────────────────────────────────
# 'elevenlabs' usa voz de nuvem; qualquer outro valor (ou ausente) usa a voz do
# navegador, que não custa nada.
#
# A CHAVE da ElevenLabs NUNCA vem aqui: ela é um secret do projeto Supabase,
# lido pela Edge Function `tts` — a mesma via do `ai-chat`. É isso que faz a voz
# funcionar em QUALQUER máquina, sem ninguém precisar da chave localmente:
#
#   supabase secrets set ELEVENLABS_API_KEY=<valor-secreto>
#   supabase functions deploy tts
VITE_TTS_PROVIDER=elevenlabs
# Só para desenvolver a integração offline, com a chave em .env.local:
VITE_TTS_ENDPOINT=/api/tts

# ─── Feature flags ───────────────────────────────────────────────────────────
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_EQUIPMENT_REGISTRATION=true
VITE_ENABLE_PREDICTIVE_MAINTENANCE=true

# ─── Intervalos de atualização (ms) ──────────────────────────────────────────
VITE_DASHBOARD_REFRESH_INTERVAL=15000
VITE_ALERTS_REFRESH_INTERVAL=15000

# ─── UI ──────────────────────────────────────────────────────────────────────
VITE_THEME=dark
VITE_SIDEBAR_OPEN_BY_DEFAULT=true
VITE_MAX_ALERTS_DISPLAY=10

# ─── Ambiente ────────────────────────────────────────────────────────────────
VITE_ENV=development
